<Window x:Class="StudioHub.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeckPad" Width="560" Height="780" MinWidth="320" MinHeight="300"
        Background="{StaticResource Navy}"
        Icon="pack://application:,,,/Assets/studiohub.ico">
    <Grid>
        <wv2:WebView2 x:Name="Web" />
        <TextBlock x:Name="Fallback" Visibility="Collapsed" Margin="24" TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{StaticResource Muted}" FontSize="15"
                   Text="DeckPad paneli için Microsoft Edge WebView2 gerekiyor. StudioHub penceresindeki 'Tarayıcıda aç' ile paneli tarayıcıda da kullanabilirsin." />
    </Grid>
</Window>
