<Application x:Class="StudioHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Navy" Color="#0B1530" />
        <SolidColorBrush x:Key="Text" Color="#DCE7FF" />
        <SolidColorBrush x:Key="Muted" Color="#7F93BD" />
        <FontFamily x:Key="KeyFont">pack://application:,,,/Assets/#Barlow Semi Condensed</FontFamily>
    </Application.Resources>
</Application>
