<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>StudioHub</RootNamespace>
    <AssemblyName>StudioHub</AssemblyName>
    <ApplicationIcon>Assets\studiohub.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>1.0.0</Version>
    <Product>StudioHub</Product>
    <Description>DeckPad ve CamLink için Windows yardımcısı</Description>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Tek dosya, .NET kurulumu gerektirmeyen yayın -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <!-- WPF ve Windows Forms birlikte: Forms yalnızca tepsi simgesi için, genel using'lere eklenmez. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudioHub.Core\StudioHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\studiohub.ico" />
    <Resource Include="Assets\Barlow_600SemiBold.ttf" />
    <Resource Include="Assets\BarlowSemiCondensed_700Bold.ttf" />
  </ItemGroup>

  <!-- Uygulamanın yanında duran dosyalar: arayüzler, FFmpeg, sanal kamera sürücüsü, OBS paketleri -->
  <ItemGroup>
    <Content Include="..\..\web\hub\**\*" LinkBase="hub" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\web\panel\**\*" LinkBase="panel" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\vendor\ffmpeg\**\*" LinkBase="ffmpeg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\vendor\driver\**\*" LinkBase="driver" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\vendor\obs\**\*" LinkBase="obs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- OBS kurulum betiği deponun kökündeki obs-script klasöründe (tek kaynak) -->
    <Content Include="..\..\..\obs-script\*.lua" LinkBase="obs\obs-script" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
