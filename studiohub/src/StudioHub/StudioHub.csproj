<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>StudioHub</RootNamespace>
    <AssemblyName>StudioHub</AssemblyName>
    <ApplicationIcon>Assets\studiohub.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>1.0.0</Version>
    <Product>StudioHub</Product>
    <Description>DeckPad için Windows yardımcısı</Description>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Tek dosya, .NET kurulumu gerektirmeyen yayın. Yalnız yerel DLL'ler (WPF, WebView2Loader) açılışta
       %TEMP%\.net\StudioHub altına çıkarılır; yönetilen DLL'ler exe'den yüklenir. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <!-- WPF ve Windows Forms birlikte: Forms yalnızca tepsi simgesi için, genel using'lere eklenmez. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudioHub.Core\StudioHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\studiohub.ico" />
    <Resource Include="Assets\Barlow_600SemiBold.ttf" />
    <Resource Include="Assets\BarlowSemiCondensed_700Bold.ttf" />
  </ItemGroup>

  <!-- Yönetim arayüzü, DeckPad paneli ve OBS kurulum betiği exe'nin içine gömülür (dağıtılan tek dosya).
       Açılışta %LOCALAPPDATA%\StudioHub\web altına çıkarılır: App.ExtractWebContent, "web/" önekli adlar.
       Not: Dosya adı "ad.<kültür>.uzantı" biçimindeyse (ör. x.tr.js) MSBuild onu uydu derlemesine taşır; böyle ad kullanma. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\web\hub\**\*" LogicalName="web/hub/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="..\..\web\panel\**\*" LogicalName="web/panel/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
    <!-- OBS kurulum betiği deponun kökündeki obs-script klasöründe (tek kaynak) -->
    <EmbeddedResource Include="..\..\..\obs-script\*.lua" LogicalName="web/obs/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
